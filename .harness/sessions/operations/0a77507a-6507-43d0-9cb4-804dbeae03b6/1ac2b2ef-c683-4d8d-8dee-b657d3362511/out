// ---- transcript rendering ----

func (m *Model) renderTranscript() string {
	width := max(m.viewport.Width-1, 20)
	parts := make([]string, 0, len(m.blocks))
	for index := range m.blocks {
		if line := m.renderBlock(&m.blocks[index], width); line != "" {
			parts = append(parts, line)
		}
	}
	return strings.Join(parts, "\n\n")
}

func (m *Model) renderBlock(b *block, width int) string {
	switch b.kind {
	case blockMeta:
		return dimStyle.Render(wrap("· "+b.text, width))
	case blockUser:
		return userStyle.Render(wrap("❯ "+b.text, width))
	case blockAssistant:
		return m.renderMarkdown(b, width)
	case blockReasoning:
		return dimStyle.Render(wrap("· "+b.text, width))
	case blockError:
		return errorStyle.Render(wrap("✗ "+b.text, width))
	case blockDivider:
		return dimStyle.Render("── " + b.text + " " + strings.Repeat("─", max(width-len(b.text)-4, 3)))
	case blockTool:
		return m.renderToolCard(b.tool, width)
	}
	return ""
}

var markdownCache []*glamour.TermRenderer

func (m *Model) renderMarkdown(b *block, width int) string {
	if b.rendered != "" && b.width == width {
		return b.rendered
	}
	renderer, err := glamour.NewTermRenderer(
		glamour.WithWordWrap(max(width-1, 20)),
		glamour.WithAutoStyle(),
	)
	if err != nil {
		b.rendered, b.width = wrap(b.text, width), width
		return b.rendered
	}

